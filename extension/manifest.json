{
  "manifest_version": 3,
  "name": "Salesforce Report to Sheets",
  "version": "1.0.0",
  "description": "Export a Salesforce report to Google Sheets and sync edited cells back.",
  "key": "",
  "action": {
    "default_title": "Salesforce ↔ Google Sheets",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "minimum_chrome_version": "102"
}
